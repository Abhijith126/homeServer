[Unit]
Description=Homelab restic backup
Wants=network-online.target
After=network-online.target docker.service remote-fs.target

[Service]
Type=oneshot
WorkingDirectory={{ homelab_repo_dir }}
# Runs as root so restic can read every stack's data under /opt/homelab/data.
ExecStart=/usr/bin/env bash {{ homelab_repo_dir }}/scripts/backup.sh
# Backups + prune can be slow on first run; don't let systemd kill it.
TimeoutStartSec=6h
