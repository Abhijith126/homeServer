# ═══════════════════════════════════════════════════════════════
# MASTER homelab configuration — the ONE file you edit.
#
#   cp .env.example .env
#   $EDITOR .env          # set the SECRETS below (and tweak defaults if needed)
#   make config           # generates every stack's .env from this file
#
# `make config` writes stacks/<node>/<app>/.env by taking each stack's
# committed defaults and overriding any key you set here. It refuses to finish
# while any secret is still CHANGEME. You never have to edit stack folders.
#
# Any variable set here overrides that key in EVERY stack that uses it — so you
# can also centralize things like ports or paths by adding them below.
# ═══════════════════════════════════════════════════════════════

# ── Shared defaults (applied to every stack that uses them) ──
PUID=1000
PGID=1000
TZ=Europe/Amsterdam
STORAGE_HOST=192.168.1.120
DOCKER_HOST=192.168.1.121
PIHOLE_HOST_IP=192.168.1.121
DOCKER_DATA=/opt/homelab/data
MEDIA_ROOT=/mnt/nas

# ── Backrest / Restic ──
# Keep existing RESTIC_REPO_PATH overrides and RESTIC_PASSWORD unchanged.
# Config import and schedules require docs/migration.md; no auto-init or deletion.
BACKREST_PORT=9898
# Set per host to STORAGE_HOST or DOCKER_HOST; NEVER 0.0.0.0/public interfaces.
# BACKREST_BIND_IP=192.168.1.120
BACKREST_STORAGE_CRON=0 2 * * *
BACKREST_DOCKER_CRON=0 4 * * *
BACKREST_CHECK_CRON=0 12 * * 0
BACKREST_ENABLE_SCHEDULES=false
IMMICH_EXPORT_DIR=/mnt/hdd2/immich
BACKREST_IMMICH_SSH_TARGET=backup@192.168.1.120
BACKREST_IMMICH_SSH_PORT=22
# Base64 of a bcrypt hash (see migration guide), never a plaintext UI password.
BACKREST_AUTH_BCRYPT=CHANGEME
# Proposal only. No generated deletion policy consumes these until manual review.
BACKREST_KEEP_DAILY=7
BACKREST_KEEP_WEEKLY=4
BACKREST_KEEP_MONTHLY=6

# ── Reverse proxy (Caddy) ──
DOMAIN=home.example.com
ACME_EMAIL=you@example.com
# Home Assistant runs in its own VM; set its LAN IP independently of DOCKER_HOST.
HA_HOST=192.168.1.122

# ── Deployment email summaries (optional; leave addresses blank to disable) ──
# Reuse the Brevo SMTP login/key configured in Uptime Kuma's UI.
# Kuma stores its notifications separately; these variables configure the updater.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_TO=

# ═══════════════ SECRETS — fill these in ═══════════════
# `make config` will not complete until none of these say CHANGEME.

# Immich database password (use only A-Za-z0-9).
DB_PASSWORD=CHANGEME

# Restic repo encryption password — set the SAME value on every node.
# Without it the backups are UNRECOVERABLE, so store it somewhere safe too.
#   generate:  openssl rand -base64 24
RESTIC_PASSWORD=CHANGEME

# Homarr — 64 hex chars:  openssl rand -hex 32
HOMARR_SECRET_ENCRYPTION_KEY=CHANGEME

# Pi-hole admin password.
PIHOLE_WEBPASSWORD=CHANGEME

# Beszel agent — the public key shown in the hub's "Add System" dialog.
BESZEL_AGENT_KEY=CHANGEME

# Deployment email credentials. Use an SMTP key, not a Brevo API/account password.
# Set these only in the ignored root .env on each node.
SMTP_USERNAME=
SMTP_PASSWORD=

# qBittorrent VPN (gluetun) provider credentials.
# For an OpenVPN provider (e.g. FastestVPN) set these + VPN_TYPE=openvpn in the
# qbittorrent stack; for WireGuard, add WIREGUARD_PRIVATE_KEY / WIREGUARD_ADDRESSES.
OPENVPN_USER=CHANGEME
OPENVPN_PASSWORD=CHANGEME

# Portfolio release is pinned in stacks/docker/portfolio/Dockerfile, not local env.
