# ═══════════════════════════════════════════════════════════════
# MASTER homelab configuration — the ONE file you edit.
#
#   cp .env.example .env
#   $EDITOR .env          # set the SECRETS below (and tweak defaults if needed)
#   make config           # generates every stack's .env from this file
#
# `make config` writes stacks/<node>/<app>/.env by taking each stack's
# committed defaults and overriding any key you set here. It refuses to finish
# while any secret is still CHANGEME. You never have to edit stack folders.
#
# Any variable set here overrides that key in EVERY stack that uses it — so you
# can also centralize things like ports or paths by adding them below.
# ═══════════════════════════════════════════════════════════════

# ── Shared defaults (applied to every stack that uses them) ──
PUID=1000
PGID=1000
TZ=Europe/Amsterdam
DOCKER_DATA=/opt/homelab/data
MEDIA_ROOT=/mnt/nas

# ── Backups (restic) ──
# One encrypted, deduplicated repo on the backup disk (hdd2), shared by every
# node — snapshots are tagged per host. The path differs per node because the
# clients reach hdd2 over NFS:
#   storage (ryzen):  RESTIC_REPOSITORY=/mnt/hdd2/restic
#   apps / infra:     RESTIC_REPOSITORY=/mnt/nfs/backup/restic
RESTIC_REPOSITORY=/mnt/nfs/backup/restic
# All app state lives here (bind-mount convention), so one path covers everything.
BACKUP_PATHS=/opt/homelab/data
# Retention for `restic forget --prune`.
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=6

# ── Reverse proxy (Caddy) ──
DOMAIN=home.example.com
ACME_EMAIL=you@example.com

# ── Update-notification emails (Diun) ──
MAIL_FROM=homelab@example.com
MAIL_TO=you@example.com

# ═══════════════ SECRETS — fill these in ═══════════════
# `make config` will not complete until none of these say CHANGEME.

# Immich database password (use only A-Za-z0-9).
DB_PASSWORD=CHANGEME

# Restic repo encryption password — set the SAME value on every node.
# Without it the backups are UNRECOVERABLE, so store it somewhere safe too.
#   generate:  openssl rand -base64 24
RESTIC_PASSWORD=CHANGEME

# Homarr — 64 hex chars:  openssl rand -hex 32
HOMARR_SECRET_ENCRYPTION_KEY=CHANGEME

# Pi-hole admin password.
PIHOLE_WEBPASSWORD=CHANGEME

# Beszel agent — the public key shown in the hub's "Add System" dialog.
BESZEL_AGENT_KEY=CHANGEME

# Diun SMTP credentials (Brevo relay by default).
SMTP_USERNAME=CHANGEME
SMTP_PASSWORD=CHANGEME

# qBittorrent VPN (gluetun) provider credentials.
# For an OpenVPN provider (e.g. FastestVPN) set these + VPN_TYPE=openvpn in the
# qbittorrent stack; for WireGuard, add WIREGUARD_PRIVATE_KEY / WIREGUARD_ADDRESSES.
OPENVPN_USER=CHANGEME
OPENVPN_PASSWORD=CHANGEME

# Portfolio — your built image reference (build & push it first).
PORTFOLIO_IMAGE=ghcr.io/CHANGEME/portfolio:1.0.0
