# ─── beszel-agent — metrics agent (deploy on EVERY node) ───
# Copy to .env (gitignored) and fill in on each host.

# Port the agent listens on (must match what you set in the hub).
BESZEL_AGENT_PORT=45876

# Public key shown by the Beszel hub when you "Add System". CHANGE it.
BESZEL_AGENT_KEY=CHANGEME
