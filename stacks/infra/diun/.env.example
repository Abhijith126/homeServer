# ─── diun — image update notifications (deploy on EVERY node) ───
# Copy to .env (gitignored) and fill in. Never commit .env.

TZ=Europe/Amsterdam
DOCKER_DATA=/opt/homelab/data

# ── Email notifications (Brevo SMTP example) ──
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=CHANGEME
SMTP_PASSWORD=CHANGEME
MAIL_FROM=homelab@example.com
MAIL_TO=you@example.com
