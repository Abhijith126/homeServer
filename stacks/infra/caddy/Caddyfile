# ─────────────────────────────────────────────────────────────
# Homelab reverse-proxy routes.
# Upstreams use node hostnames (ryzen / apps / infra) — resolvable via
# Tailscale MagicDNS or /etc/hosts. Automatic HTTPS via Let's Encrypt;
# for a Tailscale-only setup swap the ACME block for `tls internal` or a
# DNS-01 challenge (see the commented example at the bottom).
# ─────────────────────────────────────────────────────────────
{
	email {$ACME_EMAIL}
	# DNS-01 challenge via Cloudflare for ALL sites (real certs, no public exposure).
	# Token comes from cloudflare.env on the infra node (see cloudflare.env.example).
	acme_dns cloudflare {$CLOUDFLARE_API_TOKEN}
}

# Hostnames are kept identical to the Cloudflare tunnel's public hostnames so the
# SAME URL works on LAN (here, direct) and remotely (tunnel) — split-horizon.

# ── storage node (ryzen) ──
photos.{$DOMAIN} {
	reverse_proxy ryzen:2283
}

jellyfin.{$DOMAIN} {
	reverse_proxy ryzen:8096
}

drive.{$DOMAIN} {
	reverse_proxy ryzen:8082
}

torrent.{$DOMAIN} {
	# qBittorrent WebUI (published by gluetun). Stack uses 8080; the tunnel
	# currently points at 8083 — reconcile when qBittorrent is fixed.
	reverse_proxy ryzen:8080
}

# ── apps node ──
sonarr.{$DOMAIN} {
	reverse_proxy apps:8989
}

radarr.{$DOMAIN} {
	reverse_proxy apps:7878
}

lidarr.{$DOMAIN} {
	reverse_proxy apps:8686
}

bazarr.{$DOMAIN} {
	reverse_proxy apps:6767
}

prowlarr.{$DOMAIN} {
	reverse_proxy apps:9696
}

server.{$DOMAIN} {
	reverse_proxy apps:7575
}

has.{$DOMAIN} {
	reverse_proxy apps:8123
}

uptime.{$DOMAIN} {
	reverse_proxy apps:3001
}

# Portfolio is served at the ROOT domain via the tunnel; not deployed on LAN yet.
# When ready, uncomment and point at its upstream:
# {$DOMAIN} {
# 	reverse_proxy ryzen:5172
# }

# ── infra node ──
pihole.{$DOMAIN} {
	redir / /admin
	reverse_proxy infra:8081
}

beszel.{$DOMAIN} {
	reverse_proxy infra:8090
}

docker.{$DOMAIN} {
	# Portainer serves HTTPS with a self-signed cert on 9443.
	reverse_proxy https://infra:9443 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

# ── Tailscale-only / internal TLS alternative ──
# Replace the per-site auto-HTTPS above with internal certs by adding
# `tls internal` inside each site block, or use a DNS-01 challenge:
#
#   *.{$DOMAIN} {
#       tls {
#           dns cloudflare {$CLOUDFLARE_API_TOKEN}
#       }
#       @photos host photos.{$DOMAIN}
#       handle @photos { reverse_proxy ryzen:2283 }
#       ...
#   }
