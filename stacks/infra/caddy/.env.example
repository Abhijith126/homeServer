# ─── caddy — reverse proxy (infra node) ───
# Copy to .env (gitignored) and fill in.

# Base domain; per-app subdomains are derived (photos.${DOMAIN}, etc.).
DOMAIN=home.example.com

# Email for Let's Encrypt registration / expiry notices.
ACME_EMAIL=you@example.com

# Node LAN addresses; bootstrap sets these for your own homelab.
STORAGE_HOST=192.168.1.120
APPS_HOST=192.168.1.121
INFRA_HOST=192.168.1.122

# Use local_certs for internal TLS, or this Cloudflare DNS-01 option.
CADDY_GLOBAL_OPTIONS='acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}'
