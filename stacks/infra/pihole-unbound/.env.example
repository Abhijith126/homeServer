# ─── pihole-unbound — DNS + ad-blocking (infra node) ───
# Copy to .env (gitignored) and fill in. Never commit .env.

TZ=Europe/Amsterdam
DOCKER_DATA=/opt/homelab/data

# The infra node's LAN IP (clients point their DNS here).
PIHOLE_HOST_IP=192.168.1.120

# Web UI host port (Caddy proxies pihole.${DOMAIN}; keep 80 free for Caddy).
PIHOLE_WEB_PORT=8081

# Admin password — CHANGE it.
PIHOLE_WEBPASSWORD=CHANGEME

# Conditional forwarding: your router (for local hostname resolution).
ROUTER_IP=192.168.1.1
LOCAL_DOMAIN=local
LAN_CIDR=192.168.0.0/16

# Backup target for backup.sh (NFS mount from ryzen).
NFS_BACKUP=/mnt/nfs/backup
