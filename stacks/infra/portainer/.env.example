# ─── portainer — management server (infra node) ───
# Copy to .env (gitignored) and fill in.

TZ=Europe/Amsterdam
DOCKER_DATA=/opt/homelab/data

# HTTPS web UI host port (self-signed cert; Caddy terminates public TLS).
PORTAINER_PORT=9443

# Backup target for backup.sh (NFS mount from ryzen).
NFS_BACKUP=/mnt/nfs/backup
