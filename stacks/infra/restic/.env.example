# ─── restic backups (infra node) ───
# Copy to .env via `make config`. RESTIC_PASSWORD comes from the root .env and
# must be identical on every node (it encrypts the shared repo).

TZ=Europe/Amsterdam
DOCKER_DATA=/opt/homelab/data

# Host path of the shared repo — the hdd2 backup disk reached over NFS.
RESTIC_REPO_PATH=/mnt/nfs/backup/restic

# Schedule (resticker cron: sec min hour dom mon dow; dow 0=Sun). Twice a week
# (Wed + Sun), offset from other nodes so they don't contend for the repo lock.
RESTIC_BACKUP_CRON=0 30 2 * * 0,3

# ── Secret (from root .env) ──
RESTIC_PASSWORD=CHANGEME
