# ─── <app> ───
# Copy to .env (gitignored) and fill in. Never commit .env.

# ── Shared host identity & paths (keep in sync with root .env.example) ──
PUID=1000
PGID=1000
TZ=Europe/Amsterdam
DOCKER_DATA=/opt/homelab/data

# ── NFS mounts (from the ryzen storage node) — uncomment if used ──
# NFS_MEDIA=/mnt/nfs/media
# NFS_DOWNLOADS=/mnt/nfs/downloads
# NFS_BACKUP=/mnt/nfs/backup

# ── <app>-specific ──
<APP>_PORT=8080
