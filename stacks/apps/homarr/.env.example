# ─── homarr — dashboard (apps node) ───
# Copy to .env (gitignored) and fill in.

TZ=Europe/Amsterdam
DOCKER_DATA=/opt/homelab/data

# Web UI host port.
HOMARR_PORT=7575

# Backup target for backup.sh (NFS mount from ryzen).
NFS_BACKUP=/mnt/nfs/backup

# Encrypts stored integration credentials. Generate with:  openssl rand -hex 32
HOMARR_SECRET_ENCRYPTION_KEY=CHANGEME_64_hex_chars
