# ─── homeassistant — home automation (apps node) ───
# Copy to .env (gitignored) and fill in.

TZ=Europe/Amsterdam
DOCKER_DATA=/opt/homelab/data

# Media root (NFS mount of the ryzen NAS); exposed to HA at /media.
MEDIA_ROOT=/mnt/nas

# Backup target for backup.sh (NFS mount from ryzen).
NFS_BACKUP=/mnt/nfs/backup
