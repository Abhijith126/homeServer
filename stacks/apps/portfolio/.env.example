# ─── portfolio — personal website (apps node) ───
# Copy to .env (gitignored) and fill in.

TZ=Europe/Amsterdam

# Built image reference. Build & push from your portfolio repo, e.g.
#   docker build -t ghcr.io/<you>/portfolio:1.0.0 . && docker push ghcr.io/<you>/portfolio:1.0.0
PORTFOLIO_IMAGE=ghcr.io/CHANGEME/portfolio:1.0.0

# Web host port (container listens on 3000).
PORTFOLIO_PORT=3000
