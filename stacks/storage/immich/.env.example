# ─── immich — photo & video backup (storage node / ryzen) ───
# Copy to .env (gitignored) and fill in. Never commit .env.
# On ryzen these are LOCAL paths (RAID / SSD), not NFS.

TZ=Europe/Amsterdam

# Pinned immich version (bump via Diun/Renovate; read release notes first).
IMMICH_VERSION=v3.0.3

# Host port for the web UI.
IMMICH_PORT=2283

# Photo/video library — large, on the RAID array (local path on ryzen).
IMMICH_LIBRARY=/mnt/nas/Gallery

# Base dir for the postgres data bind mount. MUST be a local disk —
# network shares are NOT supported for the immich database.
DOCKER_DATA=/opt/homelab/data

# Local backup target for backup.sh (on ryzen this is a local path).
NFS_BACKUP=/mnt/hdd2

# ── Database credentials — CHANGE the password (use only A-Za-z0-9) ──
DB_PASSWORD=CHANGEME
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
