# ─── jellyfin — media server (storage node / ryzen) ───
# Copy to .env (gitignored) and fill in.

PUID=1000
PGID=1000
TZ=Europe/Amsterdam
DOCKER_DATA=/opt/homelab/data

# Media root (the NAS/RAID array). Mounted into the container at /media.
MEDIA_ROOT=/mnt/nas

# Backup target for backup.sh (local disk on ryzen).
NFS_BACKUP=/mnt/hdd2
