# ─── filebrowser — web file manager (storage node / ryzen) ───
# Copy to .env (gitignored) and fill in.

PUID=1000
PGID=1000
TZ=Europe/Amsterdam
DOCKER_DATA=/opt/homelab/data

# Directory tree exposed by FileBrowser (mounted at /srv).
FILEBROWSER_ROOT=/mnt

# Web UI host port.
FILEBROWSER_PORT=8082

# Backup target for backup.sh (the FileBrowser database).
NFS_BACKUP=/mnt/hdd2
