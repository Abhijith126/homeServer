# ─── qbittorrent + gluetun (storage node / ryzen) ───
# Copy to .env (gitignored) and fill in. Never commit .env.

PUID=1000
PGID=1000
TZ=Europe/Amsterdam
DOCKER_DATA=/opt/homelab/data
MEDIA_ROOT=/mnt/nas
NFS_BACKUP=/mnt/hdd2

# qBittorrent WebUI host port (published by gluetun).
QBIT_PORT=8080

# LAN kept reachable through the VPN killswitch (so the WebUI still works).
LAN_NETWORK=192.168.1.0/24

# ── gluetun VPN — FastestVPN over OpenVPN ──
# Provider docs: https://github.com/qdm12/gluetun-wiki/blob/main/setup/providers/fastestvpn.md
# Credentials (OPENVPN_USER / OPENVPN_PASSWORD) are set in the root .env via `make config`.
VPN_SERVICE_PROVIDER=fastestvpn
VPN_TYPE=openvpn
OPENVPN_USER=CHANGEME
OPENVPN_PASSWORD=CHANGEME
SERVER_COUNTRIES=Netherlands
# OPENVPN_PROTOCOL=udp        # optional: udp (default) or tcp

# Optional WireGuard credentials; bootstrap fills these when selecting wireguard.
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
