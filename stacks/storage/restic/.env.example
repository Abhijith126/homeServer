# ─── restic backups (storage node / ryzen) ───
# Copy to .env (gitignored) via `make config`. RESTIC_PASSWORD comes from the
# root .env (keep it identical on every node — it encrypts the shared repo).

TZ=Europe/Amsterdam
DOCKER_DATA=/opt/homelab/data

# Host path of the restic repo. On ryzen this is the local backup disk.
RESTIC_REPO_PATH=/mnt/hdd2/restic

# Schedules (resticker cron: sec min hour dom mon dow; dow 0=Sun). Twice a week
# (Wed + Sun), staggered so the two jobs never hit the repo lock at once.
RESTIC_BACKUP_CRON=0 0 2 * * 0,3
RESTIC_MEDIA_CRON=0 0 4 * * 0,3
RESTIC_CHECK_CRON=0 0 6 * * 0

# ── Secret (from root .env) ──
RESTIC_PASSWORD=CHANGEME
