# ─── duplicati — encrypted backups (storage node / ryzen) ───
# Copy to .env (gitignored) and fill in. Never commit .env.

PUID=1000
PGID=1000
TZ=Europe/Amsterdam
DOCKER_DATA=/opt/homelab/data

# What to back up (mounted read-only at /source) and where to (/backups).
MEDIA_ROOT=/mnt/nas
BACKUP_ROOT=/mnt/hdd2

# Web UI host port.
DUPLICATI_PORT=8200

# Backup target for backup.sh (duplicati's own config).
NFS_BACKUP=/mnt/hdd2

# ── Secrets — CHANGE these ──
DUPLICATI_WEBSERVICE_PASSWORD=CHANGEME
DUPLICATI_SETTINGS_ENCRYPTION_KEY=CHANGEME
