# portfolio — personal website (apps node)
# Defaults are merged with the root .env by make config.

TZ=Europe/Amsterdam

# The release is pinned in Dockerfile and updated by Renovate.

# Keep 3000 to match the existing Caddy upstream and apps-node firewall rule.
PORTFOLIO_PORT=3000

# Repository publishing portfolio-build.zip and its sha256 checksum.
PORTFOLIO_REPOSITORY=Abhijith126/portfolio
