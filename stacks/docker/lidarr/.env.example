# ─── lidarr — music management (apps node) ───
# Copy to .env (gitignored) and fill in.

PUID=1000
PGID=1000
TZ=Europe/Amsterdam
DOCKER_DATA=/opt/homelab/data

# Media root (NFS mount of the ryzen NAS on this node).
MEDIA_ROOT=/mnt/nas

# Web UI host port.
LIDARR_PORT=8686

# Backup target for backup.sh (NFS mount from ryzen).
NFS_BACKUP=/mnt/nfs/backup
