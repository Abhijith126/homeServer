# ─── uptime-kuma — uptime & status monitoring (apps node) ───
# Copy to .env (gitignored) and fill in. Never commit .env.

TZ=Europe/Amsterdam
DOCKER_DATA=/opt/homelab/data

# Host port for the web UI (container listens on 3001).
UPTIME_KUMA_PORT=3001

# Backup target (NFS mount from the ryzen storage node).
NFS_BACKUP=/mnt/nfs/backup
