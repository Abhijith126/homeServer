# ── Secrets & local environment — NEVER commit ──
.env
**/.env
# ...but always keep the committed templates
!.env.example
!**/.env.example

# Caddy Cloudflare DNS-01 token — infra-only, not managed by gen-env
cloudflare.env
**/cloudflare.env
!**/cloudflare.env.example

# ── Ansible ──
*.retry
ansible/vault-password*
ansible/inventory.local*

# ── Encryption keys / certs ──
*.age
*.key
*.pem
age.key

# ── Runtime / data (should live outside the repo; guard anyway) ──
data/
.deploy-state/
**/data/
*.log

# ── OS / editor ──
.DS_Store
Thumbs.db
*.swp
*.bak
.idea/
.vscode/

# Local bootstrap settings, credentials, and provisioning tools
.bootstrap/
__pycache__/
